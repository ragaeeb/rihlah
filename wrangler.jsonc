{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rihlah",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/games/*", "/src/*"]
  },
  "routes": [
    { "pattern": "retro.al-iyaal.club", "custom_domain": true }
  ],
  "r2_buckets": [
    {
      "binding": "GAMES",
      "bucket_name": "rihlah-games"
    }
  ]
}
